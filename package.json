{
  "name": "smart-board-tools",
  "version": "1.1.0",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.qianyulei.smart-board-tools",
    "files": [
      "**/*"
    ],
    "win": {
      "icon": "./favicon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "author": "qianyulei",
  "license": "ISC",
  "description": "smart-board-tools",
  "dependencies": {
    "npm": "^10.8.3"
  }
}